# =============================================================
# DEWAX Sp. z o.o. - naglowki bezpieczenstwa dla pompy.dewax.pl
# Wgrane: 09.09.2026 (Etap 1 rozbudowy serwisu)
# Serwer: nazwa.pl (Apache/2 + mod_pagespeed + CDN)
#
# Whitelista CSP odpowiada temu, co strona faktycznie laduje,
# sprawdzone w kodzie stron i w samych skryptach dostawcow
# (uc.js Cookiebot, gtag/js Google, 49004516.js HubSpot) 09.09.2026.
# NIE ZAOSTRZAC bez testu: na dewax.pl zbyt ostre CSP zablokowalo
# analityke na wiele miesiecy.
# =============================================================

<IfModule mod_headers.c>

    # --- HSTS: wymusza HTTPS w przegladarce na 2 lata ---
    # includeSubDomains obejmuje tylko poddomeny pompy.dewax.pl
    # (np. www.pompy.dewax.pl), nie dewax.pl ani sklep.dewax.pl.
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

    # --- Blokada osadzania strony w cudzej ramce (clickjacking) ---
    Header always set X-Frame-Options "SAMEORIGIN"

    # --- Blokada zgadywania typu pliku przez przegladarke ---
    Header always set X-Content-Type-Options "nosniff"

    # --- Ile informacji wycieka w naglowku Referer ---
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # --- Odcina dostep do kamery, mikrofonu, lokalizacji ---
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    # --- Content Security Policy ---
    #   consent.cookiebot.com, consentcdn.cookiebot.com, *.cookiebot.com
    #                              - baner zgod Cookiebot (7a55c023-...)
    #   www.googletagmanager.com   - gtag.js dla GA4 (G-XHZDND4X1W)
    #   *.google-analytics.com, *.analytics.google.com, stats.g.doubleclick.net
    #                              - odbior pomiarow GA4 (regiony EU wlacznie)
    #   js.hs-scripts.com + js.hs-analytics.net, js.hs-banner.com,
    #   js.hsadspixel.net, js.hscollectedforms.net, js.usemessages.com,
    #   js.hsforms.net, static.hsappstatic.net
    #                              - tracker HubSpot (portal 49004516) i to,
    #                                co sam doladowuje
    #   *.hubspot.com, *.hubapi.com, *.hsforms.com, *.hscollectedforms.net
    #                              - polaczenia i ramki HubSpot
    #   fonts.googleapis.com / fonts.gstatic.com - Archivo, IBM Plex Sans
    #
    # 'unsafe-inline' jest konieczne: strona ma inline gtag(), blok zgody
    # Cookiebot i style w kodzie. Bez tego analityka przestanie dzialac.
    # img-src https: - piksele pomiarowe GA4/HubSpot/Cookiebot.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://*.cookiebot.com https://www.googletagmanager.com https://www.google-analytics.com https://js.hs-scripts.com https://js.hs-analytics.net https://js.hs-banner.com https://js.hsadspixel.net https://js.usemessages.com https://js.hsforms.net https://js.hscollectedforms.net https://static.hsappstatic.net https://js.hubspot.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://consent.cookiebot.com https://consentcdn.cookiebot.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://*.cookiebot.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://stats.g.doubleclick.net https://api.hubspot.com https://forms.hubspot.com https://api.hsforms.com https://forms.hscollectedforms.net https://track.hubspot.com https://*.hubspot.com https://*.hubapi.com https://*.hsforms.com https://*.hscollectedforms.net https://*.hs-analytics.net https://*.hs-banner.com https://*.usemessages.com wss://*.hubspot.com; frame-src 'self' https://consentcdn.cookiebot.com https://app.hubspot.com https://*.hubspot.com https://www.googletagmanager.com https://td.doubleclick.net; form-action 'self' https://forms.hsforms.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

    # --- Ukrycie wersji PHP w naglowkach ---
    Header always unset X-Powered-By
    Header always unset X-AspNet-Version

</IfModule>

# --- Blokada dostepu do plikow wrazliwych ---
# (blokada listowania katalogow: Options -Indexes jest na koncu pliku)
<FilesMatch "(^\.|\.(bak|config|sql|fla|ini|log|sh|inc|swp|dist|env)$|~$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# =============================================================
# WERYFIKACJA PO WGRANIU:
# https://securityheaders.com/?q=pompy.dewax.pl  ->  A lub A+
# Jesli przestanie dzialac baner cookies, kalkulator albo formularz:
# F12 -> Console -> wpis "Refused to load" wskaze domene do dopisania.
# =============================================================

# ---- pompy.dewax.pl · konfiguracja dla nazwa.pl (Apache) ----

# Strona startowa
DirectoryIndex index.html

# Wymuszenie HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  # Jeden adres kanoniczny: www.pompy.dewax.pl prowadzi na pompy.dewax.pl.
  # Zadziala dopiero, gdy certyfikat obejmie takze nazwe z www.
  RewriteCond %{HTTP_HOST} ^www\.pompy\.dewax\.pl$ [NC]
  RewriteRule ^(.*)$ https://pompy.dewax.pl/$1 [R=301,L]
</IfModule>

# Kompresja — najważniejsze dla szybkości HTML i CSS
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
</IfModule>

# Pamięć podręczna przeglądarki
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType text/css   "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html  "access plus 1 hour"
</IfModule>

# Poprawny typ dla WebP (starsze konfiguracje Apache)
<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

# Kodowanie
AddDefaultCharset UTF-8

# ---- PRZEKIEROWANIA 301 ZE STARYCH ADRESÓW ----
# Pod tym adresem stała wcześniej strona na CakePHP z podstronami.
# Lista poniżej jest uzupełniona: bez niej stare adresy zwrócą 404
# razem z pozycjami w Google i ruchem z zewnętrznych linków.
# --- początek listy przekierowań ---
# Komplet dziewięciu podstron starej strony na CakePHP:
# sześć z jej sitemap.xml, trzy (galeria, kalkulator, wycena) z audytu — sitemap ich pomijał.
#
# Użyto RedirectMatch, a nie Redirect, celowo. Redirect dopasowuje początek adresu
# i dokleja resztę do celu, więc "/kontakt/" trafiłoby na "/#kontakt/" — kotwica
# przestaje działać. Wzorce ^...$ z opcjonalnym ukośnikiem trafiają dokładnie.

# UWAGA (04.09.2026). Sprawdzone na zywym serwerze: nazwa.pl ignoruje dyrektywy
# RedirectMatch z modulu mod_alias. Wszystkie osiem starych adresow zwracalo 404,
# mimo ze reguly byly w tym pliku. Dziala natomiast mod_rewrite, ktory obsluguje
# tez wymuszenie HTTPS wyzej. Dlatego przekierowania sa napisane jako RewriteRule.
# Flaga NE jest konieczna: bez niej Apache zamienia "#" na "%23" i kotwica przestaje dzialac.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^kalkulator/?$                          /#kreator          [R=301,L,NE]
  RewriteRule ^galeria/?$                             /#realizacje       [R=301,L,NE]
  RewriteRule ^wycena/?$                              /#kontakt          [R=301,L,NE]
  RewriteRule ^kontakt/?$                             /#kontakt          [R=301,L,NE]
  RewriteRule ^strona/nasza-oferta/?$                 /pompy.html        [R=301,L]
  RewriteRule ^strona/o-nas/?$                        /#krecik           [R=301,L,NE]
  RewriteRule ^strona/dotacje-na-zakup-pompy-ciepa/?$ /#dofinansowanie   [R=301,L,NE]
  RewriteRule ^strona/polityka-prywatnosci/?$         /polityka-prywatnosci.html [R=301,L]
</IfModule>

# Zostawione dla serwerow, ktore obsluguja mod_alias. Na nazwa.pl nie dzialaja,
# ale nie szkodza: gdy mod_rewrite juz przekierowal, te reguly sie nie wykonaja.
RedirectMatch 301 ^/kalkulator/?$                          https://pompy.dewax.pl/#kreator
RedirectMatch 301 ^/galeria/?$                             https://pompy.dewax.pl/#realizacje
RedirectMatch 301 ^/wycena/?$                              https://pompy.dewax.pl/#kontakt
RedirectMatch 301 ^/kontakt/?$                             https://pompy.dewax.pl/#kontakt
RedirectMatch 301 ^/strona/nasza-oferta/?$                 https://pompy.dewax.pl/pompy.html
RedirectMatch 301 ^/strona/o-nas/?$                        https://pompy.dewax.pl/#krecik
RedirectMatch 301 ^/strona/dotacje-na-zakup-pompy-ciepa/?$ https://pompy.dewax.pl/#dofinansowanie
RedirectMatch 301 ^/strona/polityka-prywatnosci/?$         https://pompy.dewax.pl/polityka-prywatnosci.html

# Świadomie NIE ma tu reguły zbiorczej "^/strona/ -> strona główna".
# Nieznane stare adresy mają dostać 404.html, bo hurtowe przekierowanie
# na stronę główną Google liczy jako miękki 404.
# --- koniec listy przekierowań ---

# Strona błędu 404 (własna, z odnośnikami do sekcji — NIE przekierowanie na stronę główną,
# bo Google traktowałby to jako "miękki 404")
ErrorDocument 404 /404.html

# Blokada podglądu katalogów
Options -Indexes
