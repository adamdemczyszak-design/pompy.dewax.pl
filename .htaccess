# ---- pompy.dewax.pl · konfiguracja dla nazwa.pl (Apache) ----

# Strona startowa
DirectoryIndex index.html

# Wymuszenie HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  # Jeden adres kanoniczny: www.pompy.dewax.pl prowadzi na pompy.dewax.pl.
  # Zadziala dopiero, gdy certyfikat obejmie takze nazwe z www.
  RewriteCond %{HTTP_HOST} ^www\.pompy\.dewax\.pl$ [NC]
  RewriteRule ^(.*)$ https://pompy.dewax.pl/$1 [R=301,L]
</IfModule>

# Kompresja — najważniejsze dla szybkości HTML i CSS
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
</IfModule>

# Pamięć podręczna przeglądarki
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType text/css   "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html  "access plus 1 hour"
</IfModule>

# Poprawny typ dla WebP (starsze konfiguracje Apache)
<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

# Kodowanie
AddDefaultCharset UTF-8

# ---- PRZEKIEROWANIA 301 ZE STARYCH ADRESÓW ----
# Pod tym adresem stała wcześniej strona na CakePHP z podstronami.
# Lista poniżej jest uzupełniona: bez niej stare adresy zwrócą 404
# razem z pozycjami w Google i ruchem z zewnętrznych linków.
# --- początek listy przekierowań ---
# Komplet dziewięciu podstron starej strony na CakePHP:
# sześć z jej sitemap.xml, trzy (galeria, kalkulator, wycena) z audytu — sitemap ich pomijał.
#
# Użyto RedirectMatch, a nie Redirect, celowo. Redirect dopasowuje początek adresu
# i dokleja resztę do celu, więc "/kontakt/" trafiłoby na "/#kontakt/" — kotwica
# przestaje działać. Wzorce ^...$ z opcjonalnym ukośnikiem trafiają dokładnie.

# UWAGA (04.09.2026). Sprawdzone na zywym serwerze: nazwa.pl ignoruje dyrektywy
# RedirectMatch z modulu mod_alias. Wszystkie osiem starych adresow zwracalo 404,
# mimo ze reguly byly w tym pliku. Dziala natomiast mod_rewrite, ktory obsluguje
# tez wymuszenie HTTPS wyzej. Dlatego przekierowania sa napisane jako RewriteRule.
# Flaga NE jest konieczna: bez niej Apache zamienia "#" na "%23" i kotwica przestaje dzialac.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^kalkulator/?$                          /#kreator          [R=301,L,NE]
  RewriteRule ^galeria/?$                             /#realizacje       [R=301,L,NE]
  RewriteRule ^wycena/?$                              /#kontakt          [R=301,L,NE]
  RewriteRule ^kontakt/?$                             /#kontakt          [R=301,L,NE]
  RewriteRule ^strona/nasza-oferta/?$                 /pompy.html        [R=301,L]
  RewriteRule ^strona/o-nas/?$                        /#krecik           [R=301,L,NE]
  RewriteRule ^strona/dotacje-na-zakup-pompy-ciepa/?$ /#dofinansowanie   [R=301,L,NE]
  RewriteRule ^strona/polityka-prywatnosci/?$         /polityka-prywatnosci.html [R=301,L]
</IfModule>

# Zostawione dla serwerow, ktore obsluguja mod_alias. Na nazwa.pl nie dzialaja,
# ale nie szkodza: gdy mod_rewrite juz przekierowal, te reguly sie nie wykonaja.
RedirectMatch 301 ^/kalkulator/?$                          https://pompy.dewax.pl/#kreator
RedirectMatch 301 ^/galeria/?$                             https://pompy.dewax.pl/#realizacje
RedirectMatch 301 ^/wycena/?$                              https://pompy.dewax.pl/#kontakt
RedirectMatch 301 ^/kontakt/?$                             https://pompy.dewax.pl/#kontakt
RedirectMatch 301 ^/strona/nasza-oferta/?$                 https://pompy.dewax.pl/pompy.html
RedirectMatch 301 ^/strona/o-nas/?$                        https://pompy.dewax.pl/#krecik
RedirectMatch 301 ^/strona/dotacje-na-zakup-pompy-ciepa/?$ https://pompy.dewax.pl/#dofinansowanie
RedirectMatch 301 ^/strona/polityka-prywatnosci/?$         https://pompy.dewax.pl/polityka-prywatnosci.html

# Świadomie NIE ma tu reguły zbiorczej "^/strona/ -> strona główna".
# Nieznane stare adresy mają dostać 404.html, bo hurtowe przekierowanie
# na stronę główną Google liczy jako miękki 404.
# --- koniec listy przekierowań ---

# Strona błędu 404 (własna, z odnośnikami do sekcji — NIE przekierowanie na stronę główną,
# bo Google traktowałby to jako "miękki 404")
ErrorDocument 404 /404.html

# Blokada podglądu katalogów
Options -Indexes
